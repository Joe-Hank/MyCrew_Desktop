# OS
.DS_Store
Thumbs.db

# 运行时数据（敏感 + 体积大）
data/db/
data/logs/
data/cache/
data/secrets/
data/runtime/
output/

# 不忽略 data 子目录的 README 与 .gitkeep
!data/**/README.md
!data/**/.gitkeep

# 环境变量
.env
.env.local
.env.*.local

# 本地配置
.claude/settings.local.json
.claude/scheduled_tasks.lock
data/config/*.yaml
!data/config/README.md

# SQLite — was at data/db/ historically but the active path
# (bootstrap.paths.DB_PATH) writes to backend/mycrew.db on some runs.
backend/mycrew.db
backend/mycrew.db-journal
backend/mycrew.db-wal
backend/mycrew.db-shm

# 测试产物
/tests/playwright-report/
/tests/test-results/
