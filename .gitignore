# Node / pnpm
node_modules/
.pnpm-store/
dist/
build/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# Rust / Tauri
target/
src-tauri/target/
src-tauri/binaries/

# Vite / TypeScript
.vite/
*.tsbuildinfo

# IDE
.idea/
.vscode/
!.vscode/settings.json.example

# OS
.DS_Store
Thumbs.db

# 运行时数据（敏感 + 体积大）
data/db/
data/logs/
data/cache/
data/secrets/
data/runtime/
output/

# 诊断脚本生成的实验结果（含 LLM raw response，不放公开仓）
data/diag_*.json
data/_diag_*.json

# 不忽略 data 子目录的 README 与 .gitkeep
!data/**/README.md
!data/**/.gitkeep

# 环境变量
.env
.env.local
.env.*.local

# 本地配置
.claude/settings.local.json
.claude/scheduled_tasks.lock
data/config/*.yaml
!data/config/README.md

# SQLite — was at data/db/ historically but the active path
# (bootstrap.paths.DB_PATH) writes to backend/mycrew.db on some runs.
backend/mycrew.db
backend/mycrew.db-journal
backend/mycrew.db-wal
backend/mycrew.db-shm

# 2026-05-21: docs/ 整体退出公开仓。包含 PRD / 内部复盘 / 求职文章 /
# 失败实验记录等不适合放在公开 GitHub 上的内容。本地仍保留完整。
# 注意：本规则仅影响后续 commit，过去 commit 里仍有这些文件 — 任何
# 拿到老 commit hash 的人仍能 checkout 看到。彻底抹除需要 force-push
# 重写历史，目前不做。
docs/

# 测试产物
/tests/playwright-report/
/tests/test-results/

# Stress-test script run outputs (regenerated each run)
backend/scripts/stress_test_*_report.json
backend/scripts/_forensic_*.py
backend/scripts/_forensic_*.txt
