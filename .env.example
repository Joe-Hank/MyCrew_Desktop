# MyCrew v3 环境变量样板
# 复制为 .env 使用；切勿提交真实密钥

# === 开发模式开关 ===
# DEV=1 时，Tauri 跳过 sidecar bundle 路径，直接 spawn `uvicorn --reload`
MYCREW_DEV=0

# Mock 模式：所有 Port 替换为 Mock 实现（无真实 LLM/MCP 调用）
# 用于纯前端联调与 e2e
MYCREW_MOCK=0

# === 后端服务 ===
# Python sidecar 监听端口；运行时若占用会在 18321~18399 范围探测
MYCREW_BACKEND_PORT=18321

# 日志级别：DEBUG / INFO / WARNING / ERROR
MYCREW_LOG_LEVEL=INFO

# === LLM 凭证（运行时不应通过 env 传，仅 mock/调试时使用）===
# 正式场景：用户在设置页录入 → 主进程 keytar/Stronghold 持有
# 以下变量仅在 MYCREW_MOCK=1 时由 mock adapter 读取
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# QWEN_API_KEY=

# === Stronghold 主密码（首次启动时由 Tauri 主进程派生）===
# 不在此处明文配置；首次启动会写入 OS Keychain（失败回退到 DPAPI 加密的 keystore.json）
