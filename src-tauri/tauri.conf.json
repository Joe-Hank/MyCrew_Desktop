{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/main/tauri-app/src-tauri/tauri.conf.json",
  "productName": "MyCrew",
  "version": "0.1.0",
  "identifier": "com.mycrew.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../frontend" }
  },
  "app": {
    "windows": [
      {
        "title": "MyCrew",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mycrew-backend"
    ]
  }
}
